{
  "name": "iskrenne-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Stories API and isolated token-protected local Ollama integration",
  "type": "module",
  "engines": { "node": ">=22.0.0 <27" },
  "scripts": {
    "start": "node src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "ai:key": "node scripts/generate-ai-key.js",
    "ai:start": "node src/ai/server.js",
    "ai:worker": "node src/ai/worker-main.js",
    "ai:migrate": "node src/ai/cli.js migrate",
    "ai:diagnose": "node src/ai/cli.js diagnose",
    "ai:inspect": "node src/ai/cli.js inspect-ollama",
    "ai:summary": "node src/ai/cli.js summary",
    "ai:recover": "node src/ai/cli.js recover"
  },
  "dependencies": { "pg": "8.23.1" }
}
