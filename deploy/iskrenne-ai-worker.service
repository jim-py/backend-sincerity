[Unit]
Description=Iskrenne persistent Ollama queue and nightly scheduler
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=iskrenne-ai
Group=iskrenne-ai
WorkingDirectory=/opt/iskrenne-backend
EnvironmentFile=/etc/iskrenne-ai.env
ExecStart=/usr/bin/node src/ai/worker-main.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# Default queue + two cold-load/generation attempts fit; align with custom env limits.
TimeoutStopSec=2000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
