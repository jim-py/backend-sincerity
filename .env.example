# Copy to .env and replace both REPLACE_* values. Never commit .env.
POSTGRES_DB=iskrenne
POSTGRES_USER=iskrenne
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_TOKEN
# Published backend port and in-container HTTP port. Keep 3010 for the stated address.
PORT=3010

# AI host port (published only on 127.0.0.1 by compose.override.yaml).
# Existing server mapping 127.0.0.1:3011->3010 belongs in the existing base Compose; preserve it.
AI_PORT=3012
AI_SERVICE_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_TOKEN_USE_NPM_RUN_AI_KEY
AI_TIMEZONE=UTC
AI_QUEUE_LIMIT=8
AI_QUEUE_WAIT_MS=120000
AI_LOAD_TIMEOUT_MS=600000
AI_GENERATION_TIMEOUT_MS=300000
# Default output budget; can be raised up to 1024. Request max_tokens cannot exceed this.
AI_MAX_TOKENS=512
AI_REQUESTS_PER_MINUTE=6
AI_MAX_ATTEMPTS=2

# Docker supplies PG_* from POSTGRES_* automatically; ignore the following host-only settings.
# For optional host-side AI service/worker/migration use the SAME existing DB.
# Node --env-file does not expand ${VARIABLE}; set actual values explicitly.
# Do not expose PostgreSQL publicly to supply this connection.
PGHOST=REPLACE_WITH_EXISTING_DATABASE_HOST_REACHABLE_FROM_THE_AI_PROCESS
PGPORT=5432
PGDATABASE=iskrenne
PGUSER=iskrenne
PGPASSWORD=REPLACE_WITH_THE_EXISTING_DATABASE_PASSWORD

# Host mode defaults (Docker sets these explicitly; do not override there):
# AI_BIND_HOST=127.0.0.1
# OLLAMA_SOCKET_PATH=/run/ollama-relay/ollama.sock
